# Laravel Framework
APP_NAME="TALASTAS ICT Mapping"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Background analytics queue
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

# Seeded administrator
# Set ADMIN_SEED_PASSWORD only in your local/deployment environment. Never commit it.
ADMIN_SEED_EMAIL=admin@example.invalid
ADMIN_SEED_PASSWORD=

# Database (Supabase PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deterministic Python Analytics
PYTHON_ANALYTICS_URL=http://127.0.0.1:8002
PYTHON_ANALYTICS_TIMEOUT=15

# Prescriptive AI Providers
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
AI_CONNECT_TIMEOUT=5
AI_REQUEST_TIMEOUT=20
AI_RETRY_TIMES=1
AI_RETRY_DELAY_MS=300
AI_MAX_OUTPUT_TOKENS=700

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Groq fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=2400
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Nominatim Geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_LOOKUP_URL=https://nominatim.openstreetmap.org/lookup
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_OUTPUT_FORMAT=jsonv2
NOMINATIM_COUNTRY_CODE=ph
NOMINATIM_APP_EMAIL=mapping-contact@example.invalid

# RDBMA API (for external institution integration)
RDBMA_API_KEY=your-rdbma-api-key

# Sanctum (for API tokens)
SANCTUM_STATEFUL_DOMAINS=localhost

# Disabled until both policies are approved, effective and reviewed for rollout.
LEGAL_ENFORCE_TERMS=true

# Account security email: enable only after configuring an authorized sender.
SECURITY_MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-dedicated-talastas@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=your-dedicated-talastas@gmail.com
MAIL_FROM_NAME="TALASTAS ICT Mapping"
# Optional monitored reply-to; leave blank if no monitored address exists.
SECURITY_MAIL_REPLY_TO=
# Used only by the explicit local security:test-mail --send command.
SECURITY_MAIL_TEST_RECIPIENT=your-controlled-test-mailbox@example.invalid
# Share a database/Redis cache between workers for throttling and scheduler locks.
CACHE_STORE=database
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Local HTTP only. Production HTTPS deployments must set this true.
SESSION_SECURE_COOKIE=false

# Admin browser trust: consecutive inactive days (1-30); absolute lifetime is 30 days.
MFA_TRUST_INACTIVITY_DAYS=7

# Temporarily disabled for account role/assignment changes; set true to restore.
ROLE_UPDATES_REQUIRE_OTP=false
