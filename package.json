{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "setup:project": "powershell -ExecutionPolicy Bypass -File ./setup.ps1",
        "dev:all": "concurrently --kill-others --names LARAVEL,PYTHON,VITE,QUEUE \"php artisan serve\" \"python -m uvicorn main:app --app-dir python_service --reload --port 8002\" \"npm run dev\" \"php artisan queue:work\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.2.4",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@geoman-io/leaflet-geoman-free": "^2.19.3",
        "@supabase/ssr": "^0.10.2",
        "@supabase/supabase-js": "^2.105.1",
        "@turf/turf": "^7.3.5",
        "dotenv": "^17.4.2",
        "leaflet": "^1.9.4",
        "leaflet-search": "^4.0.0",
        "leaflet.heat": "^0.2.0",
        "leaflet.markercluster": "^1.5.3",
        "pg": "^8.20.0"
    }
}
