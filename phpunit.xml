<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="Application">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Isolated test values: this fixed encryption key is never a deployment credential. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.phpunit.php" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="SECURITY_MAIL_ENABLED" value="false" force="true"/>
        <env name="ADMIN_SEED_EMAIL" value="" force="true"/>
        <env name="ADMIN_SEED_PASSWORD" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="GROQ_API_KEY" value="" force="true"/>
        <env name="RDBMA_API_KEY" value="" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="LEGAL_ENFORCE_TERMS" value="false" force="true"/>
    </php>
</phpunit>
